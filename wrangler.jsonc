// Deployment settings for Cloudflare (read by `wrangler`, Cloudflare's deployment tool).
// What each block does is explained in README.md, "How to deploy".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",

  // The site is reachable at https://useredline.dev and https://www.useredline.dev
  // and nowhere else: the old redline.<account>.workers.dev address is off, and there
  // are no per-version preview addresses. Both domains are "custom domains": on each
  // deployment Cloudflare points them at this Worker and issues their certificates.
  // The domain must be in the same Cloudflare account as the Worker.
  "routes": [
    { "pattern": "useredline.dev", "custom_domain": true },
    { "pattern": "www.useredline.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  // The web page itself: the built files in dist/. Cloudflare serves these directly.
  // Only a request that matches no file (in practice /api/...) reaches the Worker code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Nothing about any request is recorded: Cloudflare's request logs are switched off
  // for the Worker and for the converter. (The converter writes no log lines anyway.)
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },

  // The PDF converter: the image in pdf-container/, one copy at most.
  // It starts when a PDF is asked for and is shut down after five idle minutes
  // (worker/index.ts), which also wipes its disk.
  "containers": [
    {
      "class_name": "PdfConverter",
      "image": "./pdf-container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
      "observability": { "logs": { "enabled": false } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PDF_CONVERTER", "class_name": "PdfConverter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PdfConverter"] }]
}
